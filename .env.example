# ==============================================================================
# CIVICONNECT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Settings
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Primary Database (PostgreSQL is the production primary database)
# Replace with your local PostgreSQL password and database name:
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/civiconnect_db

# Documented Local Development Fallback:
# If set to true, CiviConnect seamlessly uses local SQLite (civiconnect.db)
# when PostgreSQL credentials or service are not reachable, while transparently
# reporting the database status on the health endpoints and admin console.
ALLOW_SQLITE_FALLBACK=true

# AI Provider Settings (Google Gemini via official google-genai SDK)
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
REQUEST_TIMEOUT_SECONDS=25

# Security & Session Authentication
SECRET_KEY=civiconnect-production-grade-jwt-secret-key-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Initial Bootstrap Administrator Credentials
ADMIN_DEFAULT_EMAIL=admin@civiconnect.in
ADMIN_DEFAULT_PASSWORD=CivicAdmin@2026!
